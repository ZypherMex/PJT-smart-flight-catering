ANTHROPIC_API_KEY=your-key-here

# If your organization routes Claude through an internal AI gateway instead of
# api.anthropic.com directly, set the gateway's base URL and the model name it
# expects (gateways sometimes pin an older model id form, e.g. "claude-sonnet-5"
# instead of "claude-sonnet-5-5").
# ANTHROPIC_BASE_URL=https://your-gateway.example.com
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Only set this to true if Claude API calls fail with SELF_SIGNED_CERT_IN_CHAIN
# (common on corporate networks/VPNs with SSL-inspection proxies). Disables TLS
# verification for Claude API requests only. Prefer NODE_EXTRA_CA_CERTS instead
# if you have access to your network's root CA certificate.
# ANTHROPIC_ALLOW_INSECURE_TLS=true

# Cabin-crew / admin passkey, checked by the server. Change this before real use.
# CREW_PASSKEY=123490

# Network binding. 0.0.0.0 lets phones on the same Wi-Fi reach the server.
# HOST=0.0.0.0
# PORT=3000

# Maximum health conditions a passenger may declare.
# MAX_CONDITIONS=5
